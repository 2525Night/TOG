generator client {
  provider = "prisma-client-js"
}

// Neon Postgres is used by the Vercel API in every environment.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum AccountKind {
  CASH
  /**
   * Checking — the only kind used for עו״ש.
   */
  BANK
  /**
   * @deprecated Use CreditCard model — blocked on create/update.
   */
  CREDIT_CARD
  /**
   * @deprecated Use Loan model — blocked on create/update.
   */
  LOAN
  INVESTMENT
  OTHER
}

enum TxDirection {
  INCOME
  EXPENSE
  TRANSFER
}

enum SourceType {
  USER_INPUT
  CHAT
  FILE_UPLOAD
  DOCUMENT_EXTRACTION
  CALCULATION
  AI_INFERENCE
  MARKET_DATA
  BANK_API
  CREDIT_CARD_API
  INSURANCE_API
}

model User {
  id                  String   @id @default(cuid())
  email               String   @unique
  passwordHash        String
  displayName         String?
  role                Role     @default(USER)
  jurisdiction        String   @default("IL")
  currency            String   @default("ILS")
  onboardingCompleted Boolean  @default(false)
  /** When set, this user reads/writes the owner's ledger (שיתוף זוגי). */
  householdOwnerId    String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  householdOwner      User?    @relation("HouseholdMembers", fields: [householdOwnerId], references: [id], onDelete: SetNull)
  householdMembers    User[]   @relation("HouseholdMembers")
  householdInvites    HouseholdInvite[] @relation("HouseholdInviteOwner")

  accounts            FinancialAccount[]
  transactions        Transaction[]
  goals               Goal[]
  auditEvents         AuditEvent[]
  alerts              Alert[]
  documents           Document[]
  budgetCommitments   BudgetCommitment[]
  budgetSettings      UserBudgetSettings?
  userCategories      UserCategory[]
  loans               Loan[]
  creditCards         CreditCard[]
  installmentPlans    InstallmentPlan[]
  roeyProfile         RoeyProfile?
  roeyAiConnection    RoeyAiConnection?
  roeyConversations   RoeyConversation[]
  roeyMessages        RoeyMessage[]
  roeyActionProposals RoeyActionProposal[]
  roeyNudges          RoeyNudge[]
  financialPlan       UserFinancialPlan?
  roeyAgentRuns       RoeyAgentRun[]
  roeySemanticMemory  RoeySemanticMemory[]
  roeyEscalations     RoeyEscalation[]

  @@index([householdOwnerId])
}

model HouseholdInvite {
  id        String    @id @default(cuid())
  ownerId   String
  code      String    @unique
  labelHe   String?
  claimedBy String?
  claimedAt DateTime?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  owner User @relation("HouseholdInviteOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model FinancialAccount {
  id             String      @id @default(cuid())
  userId         String
  name           String
  kind           AccountKind @default(CASH)
  currency       String      @default("ILS")
  currentBalance Decimal     @default(0)
  isActive       Boolean     @default(true)
  sourceType     SourceType  @default(USER_INPUT)
  sourceProvider String?
  userConfirmed  Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
}

enum EconomicRole {
  STANDARD
  CARD_PURCHASE
  CARD_SETTLEMENT
  LOAN_PAYMENT
}

model Transaction {
  id                String       @id @default(cuid())
  userId            String
  accountId         String?
  direction         TxDirection
  amount            Decimal
  currency          String       @default("ILS")
  categoryKey       String
  description       String?
  note              String?
  merchantNorm      String?
  bookedAt          DateTime
  sourceType        SourceType   @default(USER_INPUT)
  sourceProvider    String?
  sourceReference   String?
  confidence        Float?
  userConfirmed     Boolean      @default(true)
  economicRole      EconomicRole @default(STANDARD)
  loanId            String?
  creditCardId      String?
  installmentPlanId String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  account         FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  loan            Loan?             @relation(fields: [loanId], references: [id], onDelete: SetNull)
  creditCard      CreditCard?       @relation(fields: [creditCardId], references: [id], onDelete: SetNull)
  installmentPlan InstallmentPlan?  @relation(fields: [installmentPlanId], references: [id], onDelete: SetNull)

  @@index([userId, bookedAt])
  @@index([userId, categoryKey])
  @@index([userId, merchantNorm])
  @@index([userId, sourceReference])
  @@index([userId, loanId])
  @@index([userId, creditCardId])
  @@index([userId, economicRole])
}

model Goal {
  id            String     @id @default(cuid())
  userId        String
  title         String
  kind          GoalKind   @default(GENERAL)
  targetAmount  Decimal
  currentAmount Decimal    @default(0)
  currency      String     @default("ILS")
  targetDate    DateTime?
  sourceType    SourceType @default(USER_INPUT)
  userConfirmed Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, kind])
}

enum GoalKind {
  GENERAL
  EMERGENCY
}

model Loan {
  id                 String    @id @default(cuid())
  userId             String
  name               String
  provider           String?
  originalAmount     Decimal
  principalBalance   Decimal
  monthlyPayment     Decimal   @default(0)
  aprPercent         Float?
  startDate          DateTime?
  endDate            DateTime?
  nextDueDate        DateTime?
  linkedCommitmentId String?
  active             Boolean   @default(true)
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedCommitment BudgetCommitment? @relation("LoanLinkedCommitment", fields: [linkedCommitmentId], references: [id], onDelete: SetNull)
  transactions     Transaction[]

  @@index([userId, active])
  @@index([linkedCommitmentId])
}

model CreditCard {
  id                 String    @id @default(cuid())
  userId             String
  name               String
  provider           String?
  lastFour           String?
  creditLimit        Decimal   @default(0)
  /**
   * Manual / migrated balance owed on the card (utilization basis).
   */
  currentBalance     Decimal   @default(0)
  billingDay         Int?
  nextBillingDate    DateTime?
  linkedCommitmentId String?
  active             Boolean   @default(true)
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedCommitment  BudgetCommitment?  @relation("CardLinkedCommitment", fields: [linkedCommitmentId], references: [id], onDelete: SetNull)
  transactions      Transaction[]
  installmentPlans  InstallmentPlan[]
  budgetCommitments BudgetCommitment[] @relation("CardPayVia")

  @@index([userId, active])
  @@index([linkedCommitmentId])
}

model InstallmentPlan {
  id                 String   @id @default(cuid())
  userId             String
  creditCardId       String
  titleHe            String
  originalAmount     Decimal
  installmentCount   Int
  installmentAmount  Decimal
  chargedCount       Int      @default(0)
  /**
   * YYYY-MM — first charged month
   */
  startMonth         String
  linkedPurchaseTxId String?
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditCard   CreditCard    @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId, active])
  @@index([creditCardId, active])
}

model AuditEvent {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  meta      String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model Alert {
  id           String    @id @default(cuid())
  userId       String
  type         String
  titleHe      String
  bodyHe       String
  severity     String    @default("medium")
  dismissed    Boolean   @default(false)
  snoozedUntil DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dismissed])
  @@index([userId, type])
}

enum DocStorageMode {
  TEMPORARY
  PERMANENT
}

enum DocStatus {
  UPLOADED
  EXTRACTED
  CONFIRMED
  REJECTED
}

model Document {
  id            String         @id @default(cuid())
  userId        String
  originalName  String
  mimeType      String
  sourceKind    String         @default("csv")
  storageMode   DocStorageMode @default(TEMPORARY)
  status        DocStatus      @default(UPLOADED)
  filePath      String?
  rawText       String?
  draftJson     String?
  importedCount Int?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum CommitmentNature {
  FIXED
  PERIODIC
}

enum CommitmentCadence {
  MONTHLY
  YEARLY
}

enum CommitmentPayVia {
  ACCOUNT
  CREDIT_CARD
}

model BudgetCommitment {
  id             String            @id @default(cuid())
  userId         String
  titleHe        String
  categoryKey    String
  merchantNorm   String?
  nature         CommitmentNature  @default(FIXED)
  expectedAmount Decimal
  cadence        CommitmentCadence @default(MONTHLY)
  /**
   * How the monthly amount is paid when recorded.
   */
  payVia         CommitmentPayVia  @default(ACCOUNT)
  /**
   * Required when payVia = CREDIT_CARD.
   */
  creditCardId   String?
  anchorDay      Int?
  /**
   * YYYY-MM — first month covered by a goal standing order.
   */
  startMonth     String?
  /**
   * YYYY-MM — last month inclusive; null when open-ended / untilGoal.
   */
  endMonth       String?
  /**
   * When true, standing runs until the linked goal is funded (endMonth ignored).
   */
  untilGoal      Boolean           @default(false)
  active         Boolean           @default(true)
  sourceType     SourceType        @default(USER_INPUT)
  userConfirmed  Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditCard  CreditCard?  @relation("CardPayVia", fields: [creditCardId], references: [id], onDelete: SetNull)
  linkedLoans Loan[]       @relation("LoanLinkedCommitment")
  linkedCards CreditCard[] @relation("CardLinkedCommitment")

  @@index([userId, active])
  @@index([userId, categoryKey])
  @@index([creditCardId])
}

model UserBudgetSettings {
  id          String   @id @default(cuid())
  userId      String   @unique
  flexibleCap Decimal?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/**
 * User-defined categories (key prefixed with custom:).
 */
model UserCategory {
  id        String   @id @default(cuid())
  userId    String
  key       String
  labelHe   String
  /**
   * fixed | variable | periodic
   */
  nature    String   @default("variable")
  /**
   * EXPENSE | INCOME
   */
  direction String   @default("EXPENSE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId, direction])
}

model RoeyProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  primaryGoal      String?
  tone             String   @default("BALANCED")
  assertiveness    String   @default("ASSERTIVE")
  notificationMode String   @default("IMPORTANT_ONLY")
  memoryEnabled    Boolean  @default(true)
  onboardingSeen   Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RoeyAiConnection {
  id                   String    @id @default(cuid())
  userId               String    @unique
  provider             String    @default("GOOGLE_AI_STUDIO")
  encryptedCredential  String
  credentialKeyVersion Int       @default(1)
  keyHint              String
  modelId              String?
  status               String    @default("CONNECTED")
  consentVersion       String
  consentedAt          DateTime
  lastValidatedAt      DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RoeyConversation {
  id        String   @id @default(cuid())
  userId    String
  titleHe   String?
  summaryHe String?
  summaryUpdatedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages RoeyMessage[]

  @@index([userId, updatedAt])
}

model RoeyMessage {
  id             String   @id @default(cuid())
  userId         String
  conversationId String
  role           String
  contentHe      String
  severity       String?
  confidence     String?
  sourcesJson    String?
  payloadJson    String?
  modelId        String?
  createdAt      DateTime @default(now())

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation RoeyConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([userId, createdAt])
}

model RoeyActionProposal {
  id                    String    @id @default(cuid())
  userId                String
  conversationId        String?
  runId                 String?
  type                  String
  status                String    @default("PENDING")
  payloadJson           String
  previewJson           String
  severity              String
  requiresDoubleConfirm Boolean   @default(false)
  expiresAt             DateTime
  approvedAt            DateTime?
  rejectedAt            DateTime?
  executedAt            DateTime?
  resultJson            String?
  errorHe               String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([conversationId])
  @@index([runId])
}

model MarketDataSnapshot {
  id          String     @id @default(cuid())
  key         String     @unique
  payloadJson String
  observedAt  DateTime
  fetchedAt   DateTime   @default(now())
  sourceType  SourceType @default(MARKET_DATA)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model RoeyNudge {
  id           String    @id @default(cuid())
  userId       String
  key          String
  titleHe      String
  bodyHe       String
  severity     String
  href         String?
  status       String    @default("OPEN")
  snoozedUntil DateTime?
  sourceJson   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId, status, updatedAt])
}

model UserFinancialPlan {
  id                String   @id @default(cuid())
  userId            String   @unique
  version           Int      @default(1)
  status            String   @default("ACTIVE")
  objectiveHe       String
  motivationHe      String?
  priority          String   @default("STABILITY")
  horizonMonths     Int?
  riskCapacity      String   @default("CONSERVATIVE")
  nextActionHe      String?
  assumptionsJson   String?
  reviewTriggersJson String?
  reviewAt          DateTime?
  lastReviewedAt    DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones FinancialPlanMilestone[]
  constraints FinancialPlanConstraint[]
  events      FinancialPlanEvent[]
}

model FinancialPlanMilestone {
  id           String    @id @default(cuid())
  planId       String
  titleHe      String
  targetAmount Decimal?
  targetDate   DateTime?
  status       String    @default("PENDING")
  progressPct  Int       @default(0)
  position     Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  plan UserFinancialPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, position])
}

model FinancialPlanConstraint {
  id        String   @id @default(cuid())
  planId    String
  type      String
  labelHe   String
  valueJson String?
  hard      Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan UserFinancialPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, type])
}

model FinancialPlanEvent {
  id          String   @id @default(cuid())
  planId      String
  version     Int
  type        String
  summaryHe   String
  reasonHe    String?
  changesJson String?
  source      String   @default("USER")
  createdAt   DateTime @default(now())

  plan UserFinancialPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, createdAt])
}

model RoeyAgentRun {
  id             String    @id @default(cuid())
  userId         String
  conversationId String?
  planId         String?
  runtimeVersion String
  promptVersion  String
  policyVersion  String
  modelId        String?
  intent         String
  state          String
  contextHash    String?
  maxModelCalls  Int       @default(3)
  maxToolCalls   Int       @default(5)
  modelCalls     Int       @default(0)
  toolCalls      Int       @default(0)
  citedFactIdsJson String?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  errorCode      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  spans RoeyAgentTraceSpan[]

  @@index([userId, createdAt])
  @@index([conversationId])
}

model RoeyAgentTraceSpan {
  id           String    @id @default(cuid())
  runId        String
  type         String
  name         String
  status       String
  inputHash    String?
  outputHash   String?
  metadataJson String?
  startedAt    DateTime  @default(now())
  completedAt  DateTime?

  run RoeyAgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, startedAt])
}

model RoeySemanticMemory {
  id                   String    @id @default(cuid())
  userId               String
  key                  String
  valueJson            String
  sourceConversationId String?
  sourceMessageId      String?
  confidence           Float     @default(1)
  userConfirmed        Boolean   @default(false)
  status               String    @default("ACTIVE")
  expiresAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId, status])
}

model RoeyClaimEvidence {
  id          String   @id @default(cuid())
  runId       String
  messageId   String?
  factId      String
  claimHe     String
  source      String
  createdAt   DateTime @default(now())

  @@index([runId])
  @@index([messageId])
}

model RoeyOutcomeReconciliation {
  id               String    @id @default(cuid())
  userId           String
  proposalId       String?   @unique
  forecastRunId    String?   @unique
  type             String
  expectedJson     String
  actualJson       String?
  status           String    @default("PENDING")
  varianceJson     String?
  dueAt            DateTime
  reconciledAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, status, dueAt])
  @@index([proposalId])
}

model RoeyEscalation {
  id                  String    @id @default(cuid())
  userId              String
  conversationId      String?
  runId               String?
  type                String
  urgency             String
  status              String    @default("OPEN")
  summaryHe           String
  evidenceFactIdsJson String?
  unresolvedJson      String?
  userApprovedHandoff Boolean   @default(false)
  resolvedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
}
