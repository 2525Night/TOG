{
  "installCommand": "cd ../.. && npm install",
  "buildCommand": "cd ../.. && npm run build -w @moneytail/shared && npm run build -w @moneytail/web",
  "framework": "nextjs",
  "headers": [
    {
      "source": "/downloads/(.*)\\.apk",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"MoneyTail5.apk\"" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    }
  ]
}
